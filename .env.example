# Docker Hub image published by .github/workflows/docker-publish.yml
DOCKERHUB_IMAGE=docker.io/tbdavid2019/888a2a-lite
A2A888_HUB_IMAGE_TAG=latest
A2A888_HUB_MAX_GROUP_MEMBERS=32
A2A888_HUB_MAX_GROUP_FANOUT=32
A2A888_HUB_MAX_GROUP_HISTORY_PAGE=100
A2A888_HUB_PEER_LEASE_SECONDS=900
A2A888_HUB_REGISTRATION_TTL_SECONDS=31536000

# Runtime secret. Keep this file local and set mode 0600.
A2A888_HUB_OPERATOR_TOKEN=replace-with-a-long-random-value

# Optional semi-open mode: require all Agent APIs to provide this pre-shared key.
# Leave unset or empty for default public mode.
# A2A888_HUB_SHARED_KEY=replace-with-a-pre-shared-key

# Optional multi-circle mode. Keep `single` for legacy PUBLIC/SEMI_OPEN behavior.
# In `multi`, no key registers into public; an allowed shared key registers into its private circle.
# A2A888_HUB_CIRCLE_MODE=multi
# A2A888_HUB_SHARED_KEYS=team-a:replace-with-key-a,team-b:replace-with-key-b
# A2A888_HUB_ALLOW_DYNAMIC_CIRCLES=true
# Required when multi-circle mode is enabled. Keep stable across restarts and backups.
# Hub 用來替所有進圈密碼做 HMAC 加密運算的「伺服器專屬鹽值（Secret Salt）」；請使用 openssl rand -hex 32
# A2A888_HUB_CIRCLE_DERIVATION_SECRET=replace-with-a-long-random-value
